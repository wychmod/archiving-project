---
/**
 * Project detail routes (zh). One page per archived project, driven entirely
 * by the content collection — no per-project template edits required.
 */
import { render } from 'astro:content';
import { getCollection } from 'astro:content';
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import { getProjects, type ProjectRecord } from '@/lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('projects', (e) => e.data.lang === 'zh');
  return entries.map((entry) => ({
    params: { ref: entry.data.ref },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const projects = await getProjects('zh');
const { Content } = await render(entry);

const project = projects.find((p) => p.ref === entry.data.ref) as ProjectRecord;
---

<ProjectLayout locale="zh" project={project} siblings={projects}>
  <Content />
</ProjectLayout>
