---
/**
 * 404 — a dead end that still offers three ways forward.
 * Spec: DESIGN-V2 §4.8
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { t } from '@/data/i18n';
import { projectsPath, withBase } from '@/lib/url';

const locale = 'zh' as const;
const s = t(locale);

const routes = [
  { icon: 'home', label: s.notFound.home, href: withBase('/') },
  { icon: 'layers', label: s.notFound.projects, href: withBase(projectsPath(locale)) },
  { icon: 'search', label: s.notFound.search, href: '#', action: 'search' },
];
---

<BaseLayout locale={locale} title={s.notFound.title} description={s.notFound.desc}>
  <section class="nf">
    <div class="nf__pattern" aria-hidden="true">
      <svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
        <defs>
          <pattern id="nf-grid" width="32" height="32" patternUnits="userSpaceOnUse">
            <path d="M32 0H0v32" fill="none" stroke="currentColor" stroke-width="0.5" />
          </pattern>
        </defs>
        <rect width="400" height="400" fill="url(#nf-grid)" />
      </svg>
    </div>

    <div class="container container--reading nf__inner">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1 class="nf__title">{s.notFound.title}</h1>
      <p class="nf__desc">{s.notFound.desc}</p>

      <ul class="nf__routes">
        {routes.map((r) => (
          <li>
            <a
              class="nf__route"
              href={r.href}
              data-search-open={r.action === 'search' ? '' : undefined}
            >
              <span class="nf__route-icon"><Icon name={r.icon} size={18} /></span>
              <span class="nf__route-label">{r.label}</span>
              <span class="nf__route-arrow"><Icon name="arrow-right" size={16} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    display: grid;
    place-items: center;
    min-height: min(72vh, 640px);
    padding-block: clamp(56px, 10vw, 120px);
    overflow: hidden;
  }

  .nf__pattern {
    position: absolute;
    inset: -10% -10% -10% -10%;
    color: var(--line);
    opacity: 0.4;
    mask-image: radial-gradient(ellipse at center, #000 10%, transparent 68%);
    pointer-events: none;
  }

  .nf__inner {
    position: relative;
    text-align: center;
  }

  .nf__code {
    font-family: var(--font-mono);
    font-size: clamp(72px, 16vw, 160px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    margin: 0 0 8px;
    background: linear-gradient(
      140deg,
      var(--brand-600),
      var(--accent-500) 70%,
      var(--brand-400)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.9;
  }

  .nf__title {
    font-size: var(--fs-display-2);
    font-weight: 650;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    color: var(--text-hi);
  }

  .nf__desc {
    font-size: var(--fs-body-lg);
    line-height: 1.7;
    color: var(--text);
    margin: 0 auto 40px;
    max-width: 44ch;
  }

  .nf__routes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    max-width: 380px;
    margin-inline: auto;
  }

  .nf__route {
    display: grid;
    grid-template-columns: 36px 1fr 20px;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--bg-1);
    color: var(--text);
    text-decoration: none;
    text-align: left;
    transition:
      border-color var(--dur-fast) var(--ease-standard),
      background var(--dur-fast) var(--ease-standard),
      transform var(--dur-fast) var(--ease-standard);
  }

  .nf__route:hover {
    border-color: var(--brand-400);
    background: var(--bg-2);
    transform: translateX(3px);
  }

  .nf__route-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r-sm);
    background: var(--brand-50);
    color: var(--brand-600);
  }

  .nf__route-label {
    font-size: var(--fs-body);
    font-weight: 550;
    color: var(--text-hi);
  }

  .nf__route-arrow {
    color: var(--text-lo);
    display: grid;
    place-items: center;
    transition: transform var(--dur-fast) var(--ease-standard);
  }

  .nf__route:hover .nf__route-arrow {
    color: var(--brand-600);
    transform: translateX(2px);
  }

  @media (max-width: 480px) {
    .nf__routes {
      max-width: 100%;
    }
  }
</style>
