---
/**
 * Project detail — hero band, two-column body with sticky TOC, related work.
 * Spec: DESIGN-V2 §4.4
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import StatusStamp from '@/components/StatusStamp.astro';
import Icon from '@/components/Icon.astro';
import { t, type Locale } from '@/data/i18n';
import {
  CATEGORY_MAP,
  archiveDocUrl,
  archivedProjectUrl,
  stackLabel,
} from '@/data/taxonomy';
import {
  extractHeadings,
  formatDate,
  isoDate,
  relatedProjects,
  type ProjectRecord,
} from '@/lib/content';
import { counterpartPath, projectsPath, withBase } from '@/lib/url';

interface Props {
  locale: Locale;
  project: ProjectRecord;
  /** All projects in this locale, for related entries and prev/next. */
  siblings: ProjectRecord[];
}

const { locale, project, siblings } = Astro.props;
const s = t(locale);

const meta = CATEGORY_MAP[project.category];
const headings = extractHeadings(project.body).filter((h) => h.depth === 2);

const index = siblings.findIndex((p) => p.ref === project.ref);
const prev = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;
const related = relatedProjects(siblings, project.ref, 3);

const counterpart = counterpartPath(Astro.url.pathname, locale === 'en' ? 'zh' : 'en');
---

<BaseLayout
  locale={locale}
  ogType="article"
  title={project.name}
  description={project.description}
  keywords={[project.name, ...project.stack.map((k) => stackLabel(k, locale))]}
  publishedAt={isoDate(project.archivedAt)}
>
  <!-- ---------- breadcrumb ---------- -->
  <div class="container container--wide">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href={withBase(locale === 'en' ? '/en/' : '/')}>{s.detail.breadcrumbHome}</a>
      <span class="crumb__sep" aria-hidden="true">/</span>
      <a href={withBase(projectsPath(locale))}>{s.detail.breadcrumbProjects}</a>
      <span class="crumb__sep" aria-hidden="true">/</span>
      <span aria-current="page">{project.name}</span>
    </nav>
  </div>

  <!-- ---------- hero band ---------- -->
  <header class="detail-hero" style={`--cat-color: var(${meta.colorVar});`}>
    <svg class="detail-hero__pattern" viewBox="0 0 1200 320" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <g stroke="currentColor" stroke-width="0.6" fill="none" opacity="0.28">
        {Array.from({ length: 25 }, (_, i) => (
          <line x1={i * 50} y1="0" x2={i * 50} y2="320" />
        ))}
      </g>
      <g stroke="currentColor" stroke-width="0.7" fill="none" opacity="0.22">
        {Array.from({ length: 5 }, (_, i) => (
          <circle cx="1010" cy="70" r={40 + i * 46} />
        ))}
      </g>
    </svg>

    <div class="container container--wide detail-hero__inner">
      <div class="detail-hero__main">
        <div class="detail-hero__badges">
          <CategoryBadge category={project.category} locale={locale} as="a" href={withBase(`${projectsPath(locale)}?category=${project.category}`)} />
          <StatusStamp status={project.status} locale={locale} />
          {project.scrubbed && (
            <StatusStamp status={project.status} scrubbed locale={locale} showFlags />
          )}
        </div>

        <h1 class="detail-hero__title">{project.name}</h1>
        {project.subtitle && <p class="detail-hero__subtitle">{project.subtitle}</p>}
        <p class="detail-hero__desc">{project.description}</p>

        <div class="detail-hero__meta">
          <span class="detail-hero__meta-item">
            <Icon name="map-pin" size={14} />
            {s.detail.archivedOn} {formatDate(project.archivedAt, locale)}
          </span>
          {project.commitCount && (
            <span class="detail-hero__meta-item">
              <Icon name="git-commit-vertical" size={14} />
              {project.commitCount} {s.detail.commits}
            </span>
          )}
          <span class="detail-hero__meta-item detail-hero__meta-item--lang">
            <Icon name="languages" size={14} />
            {locale === 'en' ? 'English' : '中文'}
          </span>
        </div>
      </div>

      <div class="detail-hero__stack" data-reveal>
        <p class="detail-hero__stack-head">{s.detail.stackTitle}</p>
        <ul class="detail-hero__chips">
          {project.stack.map((key, i) => (
            <li>
              <a
                class="chip"
                href={withBase(`${projectsPath(locale)}?stack=${encodeURIComponent(key)}`)}
                style={`animation-delay: ${i * 30}ms`}
              >
                {stackLabel(key, locale)}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </header>

  <!-- ---------- actions ---------- -->
  <div class="detail-actions">
    <div class="container container--wide detail-actions__inner">
      <a class="btn btn--primary" href={archivedProjectUrl(project.ref)} target="_blank" rel="noopener noreferrer">
        <Icon name="github" size={16} />
        {s.detail.viewSource}
      </a>
      <a class="btn btn--secondary" href={archiveDocUrl(project.ref)} target="_blank" rel="noopener noreferrer">
        <Icon name="file-text" size={16} />
        {s.detail.viewArchiveDoc}
      </a>

      <div class="detail-actions__right">
        <a class="detail-actions__util" href={withBase(counterpart)} hreflang={locale === 'en' ? 'zh-CN' : 'en'} rel="alternate">
          <Icon name="languages" size={15} />
          {s.detail.switchLang}
        </a>
        <button type="button" class="detail-actions__util" data-copy-link data-copied-label={s.detail.copied}>
          <Icon name="link" size={15} />
          <span data-copy-label>{s.detail.copyLink}</span>
        </button>
        <button type="button" class="detail-actions__util" data-print>
          <Icon name="printer" size={15} />
          {s.detail.printPage}
        </button>
      </div>
    </div>
  </div>

  <!-- ---------- body ---------- -->
  <div class="container container--wide detail-body">
    <article class="prose" data-article>
      <slot />
    </article>

    <aside class="toc" aria-label={s.detail.tocTitle}>
      <div class="toc__inner">
        <p class="toc__head">
          <Icon name="list" size={14} />
          {s.detail.tocTitle}
        </p>
        <ul class="toc__list">
          {
            headings.map((h) => (
              <li>
                <a class="toc__link" href={`#${h.id}`} data-toc-link={h.id}>{h.text}</a>
              </li>
            ))
          }
        </ul>

        {(project.repoCleared || project.scrubbed) && (
          <div class="toc__note">
            {project.repoCleared && (
              <p class="toc__note-item">
                <Icon name="alert-triangle" size={14} />
                {s.detail.sourceClearedNote}
              </p>
            )}
            {project.scrubbed && (
              <p class="toc__note-item">
                <Icon name="shield-check" size={14} />
                {s.detail.scrubbedNote}
              </p>
            )}
          </div>
        )}
      </div>
    </aside>
  </div>

  <!-- ---------- prev / next ---------- -->
  {
    (prev || next) && (
      <div class="container container--wide">
        <nav class="pn" aria-label={locale === 'zh' ? '项目导航' : 'Project navigation'}>
          {prev ? (
            <a class="pn__item" href={withBase(locale === 'en' ? `/en/projects/${prev.ref}/` : `/projects/${prev.ref}/`)}>
              <span class="pn__label"><Icon name="arrow-left" size={14} />{s.detail.prevProject}</span>
              <span class="pn__title">{prev.name}</span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a class="pn__item pn__item--next" href={withBase(locale === 'en' ? `/en/projects/${next.ref}/` : `/projects/${next.ref}/`)}>
              <span class="pn__label">{s.detail.nextProject}<Icon name="arrow-right" size={14} /></span>
              <span class="pn__title">{next.name}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      </div>
    )
  }

  <!-- ---------- related ---------- -->
  {
    related.length > 0 && (
      <section class="section">
        <div class="container container--wide">
          <h2 class="related__title">{s.detail.relatedProjects}</h2>
          <div class="grid grid--3">
            {related.map((item) => (
              <ProjectCard project={item} locale={locale} maxChips={3} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-8);
    padding-block: var(--sp-20);
    color: var(--text-lo);
    font-size: var(--fs-caption);
  }

  .crumb a {
    color: var(--text-lo);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--link);
  }

  .crumb__sep {
    color: var(--text-placeholder);
  }

  /* ---------- hero ---------- */
  .detail-hero {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--cat-color) 7%, var(--bg-1));
  }

  .detail-hero__pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--cat-color);
    pointer-events: none;
  }

  .detail-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
    gap: clamp(32px, 5vw, 64px);
    padding-block: clamp(32px, 5vw, 56px);
  }

  .detail-hero__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-8);
    margin-bottom: var(--sp-20);
  }

  .detail-hero__title {
    font-size: var(--fs-display-2);
    line-height: var(--lh-display-2);
    letter-spacing: var(--ls-display-2);
    color: color-mix(in srgb, var(--cat-color) 30%, var(--text-hi));
  }

  .detail-hero__subtitle {
    margin-top: var(--sp-8);
    color: var(--text);
    font-size: var(--fs-body-lg);
    font-weight: var(--fw-medium);
  }

  .detail-hero__desc {
    margin-top: var(--sp-16);
    max-width: 68ch;
    color: var(--text-lo);
    font-size: var(--fs-body-sm);
    line-height: 1.75;
  }

  .detail-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-16);
    margin-top: var(--sp-24);
    padding-top: var(--sp-20);
    border-top: 1px solid color-mix(in srgb, var(--cat-color) 20%, var(--line));
  }

  .detail-hero__meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-6);
    color: var(--text-lo);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
  }

  /* ---------- hero stack panel ---------- */
  .detail-hero__stack {
    align-self: start;
    padding: var(--sp-20);
    border: 1px solid color-mix(in srgb, var(--cat-color) 22%, var(--line));
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--bg-0) 82%, transparent);
  }

  @supports (backdrop-filter: blur(8px)) {
    .detail-hero__stack {
      backdrop-filter: blur(8px);
    }
  }

  .detail-hero__stack-head {
    margin-bottom: var(--sp-12);
    color: var(--text-placeholder);
    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-overline);
    text-transform: uppercase;
  }

  .detail-hero__chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-6);
  }

  .detail-hero__chips .chip {
    animation: chip-in var(--dur-base) var(--ease-entrance) backwards;
  }

  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  /* ---------- actions bar ---------- */
  .detail-actions {
    position: sticky;
    top: var(--nav-h);
    z-index: var(--z-filter);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-0) 92%, transparent);
  }

  @supports (backdrop-filter: blur(12px)) {
    .detail-actions {
      backdrop-filter: blur(12px) saturate(1.4);
    }
  }

  .detail-actions__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-12);
    padding-block: var(--sp-12);
  }

  .detail-actions .btn {
    min-height: 36px;
    padding-inline: var(--sp-16);
    font-size: var(--fs-body-sm);
  }

  .detail-actions__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-left: auto;
  }

  .detail-actions__util {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-6);
    min-height: 36px;
    padding: 0 var(--sp-12);
    border: none;
    border-radius: var(--r-md);
    background: transparent;
    color: var(--text-lo);
    font-family: inherit;
    font-size: var(--fs-caption);
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  .detail-actions__util:hover {
    background: var(--bg-2);
    color: var(--text-hi);
  }

  /* ---------- body ---------- */
  .detail-body {
    display: grid;
    grid-template-columns: minmax(0, var(--w-reading)) var(--w-toc);
    gap: clamp(32px, 5vw, 64px);
    justify-content: start;
    padding-block: clamp(32px, 5vw, 56px) 0;
  }

  /* ---------- TOC ---------- */
  .toc__inner {
    position: sticky;
    top: calc(var(--nav-h) + 72px);
  }

  .toc__head {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    margin-bottom: var(--sp-12);
    color: var(--text-placeholder);
    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-caption);
    text-transform: uppercase;
  }

  .toc__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    border-left: 1px solid var(--line);
  }

  .toc__link {
    display: block;
    padding: var(--sp-4) var(--sp-12);
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--text-lo);
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard),
      background-color var(--dur-fast) var(--ease-standard);
  }

  .toc__link:hover {
    color: var(--text-hi);
  }

  .toc__link.is-active {
    color: var(--brand-700);
    border-left-color: var(--brand-600);
    background: var(--brand-50);
    font-weight: var(--fw-medium);
  }

  .toc__note {
    margin-top: var(--sp-24);
    padding-top: var(--sp-16);
    border-top: 1px solid var(--line-soft);
    display: flex;
    flex-direction: column;
    gap: var(--sp-12);
  }

  .toc__note-item {
    display: flex;
    gap: var(--sp-8);
    color: var(--text-lo);
    font-size: var(--fs-caption);
    line-height: 1.6;
  }

  .toc__note-item svg {
    flex: none;
    margin-top: 2px;
    color: var(--accent-500);
  }

  /* ---------- prev / next ---------- */
  .pn {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-16);
    margin-top: var(--sp-40);
    padding-top: var(--sp-32);
    border-top: 1px solid var(--line);
  }

  .pn__item {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-16) var(--sp-20);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--bg-0);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-fast) var(--ease-standard);
  }

  .pn__item:hover {
    border-color: var(--brand-200);
    box-shadow: var(--e2);
  }

  .pn__item--next {
    text-align: right;
  }

  .pn__label {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
    color: var(--text-placeholder);
    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-caption);
    text-transform: uppercase;
  }

  .pn__item--next .pn__label {
    justify-content: flex-end;
  }

  .pn__title {
    color: var(--text-hi);
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
  }

  .related__title {
    margin-bottom: var(--sp-24);
    font-size: var(--fs-h2);
    letter-spacing: var(--ls-heading);
  }

  /* ---------- responsive ---------- */
  @media (max-width: 1023px) {
    .detail-hero__inner {
      grid-template-columns: 1fr;
    }

    .detail-body {
      grid-template-columns: 1fr;
    }

    .toc {
      order: -1;
    }

    .toc__inner {
      position: static;
      padding: var(--sp-16);
      border: 1px solid var(--line);
      border-radius: var(--r-md);
      background: var(--bg-1);
    }

    .toc__list {
      border-left: none;
    }

    .toc__link {
      margin-left: 0;
      border-left: none;
      padding-left: var(--sp-8);
    }

    .toc__link.is-active {
      background: var(--brand-50);
      border-radius: var(--r-sm);
    }
  }

  @media (max-width: 600px) {
    .detail-actions__right {
      width: 100%;
      margin-left: 0;
      justify-content: flex-start;
      border-top: 1px solid var(--line-soft);
      padding-top: var(--sp-8);
    }

    .pn {
      grid-template-columns: 1fr;
    }

    .pn__item--next {
      text-align: left;
    }

    .pn__item--next .pn__label {
      justify-content: flex-start;
    }
  }

  @media print {
    .detail-hero {
      background: none;
    }
  }
</style>

<script>
  // ---- copy link --------------------------------------------------------
  document.querySelectorAll<HTMLElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector<HTMLElement>('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (label) {
          const original = label.textContent ?? '';
          label.textContent = btn.dataset.copiedLabel ?? 'Copied';
          window.setTimeout(() => {
            label.textContent = original;
          }, 1600);
        }
      } catch {
        /* clipboard unavailable — silently ignore */
      }
    });
  });

  document.querySelectorAll<HTMLElement>('[data-print]').forEach((btn) => {
    btn.addEventListener('click', () => window.print());
  });

  // ---- table of contents highlighting -----------------------------------
  const article = document.querySelector<HTMLElement>('[data-article]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];

  if (article && links.length) {
    // Markdown headings do not carry ids, so derive them the same way the
    // build-time extractor does and attach them before observing.
    const slug = (text: string) =>
      text
        .toLowerCase()
        .replace(/[\s]+/g, '-')
        .replace(/[^\p{L}\p{N}-]/gu, '')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '') || 'section';

    const seen = new Map<string, number>();
    article.querySelectorAll<HTMLElement>('h2, h3').forEach((heading) => {
      const base = slug(heading.textContent ?? '');
      const n = seen.get(base) ?? 0;
      seen.set(base, n + 1);
      heading.id = n === 0 ? base : `${base}-${n}`;
    });

    const targets = links
      .map((link) => {
        const id = link.dataset.tocLink;
        const el = id ? document.getElementById(id) : null;
        return el ? { link, el } : null;
      })
      .filter((x): x is { link: HTMLAnchorElement; el: HTMLElement } => Boolean(x));

    if (targets.length && 'IntersectionObserver' in window) {
      const setActive = (id: string) => {
        links.forEach((l) => l.classList.toggle('is-active', l.dataset.tocLink === id));
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) setActive(visible[0].target.id);
        },
        { rootMargin: '-96px 0px -65% 0px', threshold: [0, 1] }
      );
      targets.forEach(({ el }) => observer.observe(el));

      links.forEach((link) => {
        link.addEventListener('click', () => {
          const id = link.dataset.tocLink;
          if (id) setActive(id);
        });
      });
    }
  }
</script>
