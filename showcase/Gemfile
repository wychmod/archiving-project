# frozen_string_literal: true

source "https://rubygems.org"

gem "jekyll-theme-chirpy", "~> 7.6"

# NOTE: intentionally NOT bundle dependencies:
#   - html-proofer: drags in the async stack; the deploy workflow installs it in the test step.
#   - wdm: Windows file-watching accelerator that requires an MSYS2 toolchain to build;
#     Jekyll falls back to polling without it.

platforms :windows, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
